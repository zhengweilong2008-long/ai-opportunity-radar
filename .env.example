# AI 机会雷达 - 环境变量示例
# 复制为 .env 后按需填写。默认全部关闭，不产生任何费用。

# ---- 网站 ----
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- 信源密钥（阶段二，部分可选）----
# Product Hunt 官方 API 需要免费 Developer Token（用户手动申请）：
# https://www.producthunt.com/v2/oauth/applications
# PH_TOKEN=
# GitHub Search API 降级通道可选（不填则用未认证额度，每小时 60 次，每日任务够用）
# GITHUB_TOKEN=
# SEC EDGAR 要求请求头带联系邮箱（建议填你的邮箱）
# SEC_CONTACT_EMAIL=

# ---- 大模型（可选，默认关闭；开启后才可能产生费用）----
# LLM_ENABLED=false
# LLM_PROVIDER=deepseek          # deepseek / siliconflow / openai_compatible
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# LLM_DAILY_CALL_LIMIT=60        # 每日调用上限，超限自动降级为规则评分
# MONTHLY_BUDGET_CNY=20          # 每月预算（元），超限停用 LLM

# ---- 零成本翻译（阶段三，MyMemory 免费 API）----
# 匿名额度 5000 字符/天；填邮箱（无需注册）可提到 50000 字符/天
# 在 GitHub 仓库 Settings -> Secrets 里配 MYMEMORY_EMAIL 即可
# MYMEMORY_EMAIL=

# ---- 通知（阶段五实现，默认关闭）----
# NOTIFY_ENABLED=false
# NOTIFY_CHANNEL=email           # email / telegram
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
